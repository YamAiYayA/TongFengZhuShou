{
  "expo": {
    "name": "痛风喝水助手",
    "slug": "tongfeng-zhushou",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tongfeng",
    "newArchEnabled": true,
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#0B6E4F",
          "defaultChannel": "water-reminders"
        }
      ],
      "./plugins/withBackgroundService"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yama.tongfengzhushou",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.yama.tongfengzhushou",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#E7F1EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "storage": "sqlite-local-v1",
      "futureSync": "mysql"
    }
  }
}
